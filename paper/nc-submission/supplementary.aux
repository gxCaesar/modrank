\@writefile{toc}{\contentsline {section}{Supplementary Note~1. The clinical-baseline census, and why grade separates few patients}{1}{section*.2}\protected@file@percent }
\newlabel{note:census}{{1}{1}{Supplementary Note~\thesnote . The clinical-baseline census, and why grade separates few patients}{section*.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Every method paper associated with the benchmark, and what it compares against. Of the eight whose text could be read, four report a clinical-variable baseline and all four build it from grade. None of the eight uses pathologic stage, and four report no clinical baseline at all. Three could not be verified and are marked as such. Among the four, the stated bladder values are 0.519 (DIMAF) and 0.570 (SurvPath and MMP, age, sex and grade).}}{2}{table.1}\protected@file@percent }
\newlabel{tab:census}{{1}{2}{Every method paper associated with the benchmark, and what it compares against. Of the eight whose text could be read, four report a clinical-variable baseline and all four build it from grade. None of the eight uses pathologic stage, and four report no clinical baseline at all. Three could not be verified and are marked as such. Among the four, the stated bladder values are 0.519 (DIMAF) and 0.570 (SurvPath and MMP, age, sex and grade)}{table.1}{}}
\@writefile{toc}{\contentsline {paragraph}{Why grade separates few patients in this disease.}{2}{section*.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Level composition and normalised Shannon entropy of grade and stage in the five studies. $\Delta $C is the concordance of age, sex and stage minus that of age, sex and grade on the same patients, a point estimate. It is positive in all five studies, and its interval excludes zero in two (Supplementary Table~8). Every row uses the clinical files released with the benchmark, the only clinical source common to all five studies. The bladder result in the main text (0.6637 against 0.5664) takes every column from the incumbent's own split files instead, which makes it a statement about the incumbent's baseline. On bladder, this table's source gives $+0.0577$. Two studies ship no usable grade, so there the grade arm is age and sex alone and the comparison shows stage improving that baseline. They are marked rather than dropped.}}{2}{table.2}\protected@file@percent }
\newlabel{tab:entropy}{{2}{2}{Level composition and normalised Shannon entropy of grade and stage in the five studies. $\Delta $C is the concordance of age, sex and stage minus that of age, sex and grade on the same patients, a point estimate. It is positive in all five studies, and its interval excludes zero in two (Supplementary Table~8). Every row uses the clinical files released with the benchmark, the only clinical source common to all five studies. The bladder result in the main text (0.6637 against 0.5664) takes every column from the incumbent's own split files instead, which makes it a statement about the incumbent's baseline. On bladder, this table's source gives $+0.0577$. Two studies ship no usable grade, so there the grade arm is age and sex alone and the comparison shows stage improving that baseline. They are marked rather than dropped}{table.2}{}}
