\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The development campaign, its generalisation and its representations.} \textbf  {a},~Predicted and observed worth of the seven components, with each prediction fixed before the run. The shaded band is the $\pm 0.0145$ bar. \textbf  {b},~The four components that carry a matched control. C5's control beats it, which is what a void looks like. \textbf  {c},~ModRank as it stood during development, five-seed means of an earlier configuration rather than the values reported in the main text, against the best published entry on the released folds, counting PIBD, which ships the released split files for all five studies, and DIMAF in bladder only. The main text's five-study comparison counts SurvPath alone. ModRank is above that entry in bladder and below it in the four other studies. \textbf  {d},~The one-column swap in the same five studies, positive in all five, with an interval excluding zero in two. \textbf  {e},~Seven slide encoders scored as single arms on identical patients and folds. \textbf  {f},~The seven-encoder pool against TITAN alone, paired on patients.}}{15}{figure.1}\protected@file@percent }
\newlabel{fig:campaign}{{1}{15}{\textbf {The development campaign, its generalisation and its representations.} \textbf {a},~Predicted and observed worth of the seven components, with each prediction fixed before the run. The shaded band is the $\pm 0.0145$ bar. \textbf {b},~The four components that carry a matched control. C5's control beats it, which is what a void looks like. \textbf {c},~ModRank as it stood during development, five-seed means of an earlier configuration rather than the values reported in the main text, against the best published entry on the released folds, counting PIBD, which ships the released split files for all five studies, and DIMAF in bladder only. The main text's five-study comparison counts SurvPath alone. ModRank is above that entry in bladder and below it in the four other studies. \textbf {d},~The one-column swap in the same five studies, positive in all five, with an interval excluding zero in two. \textbf {e},~Seven slide encoders scored as single arms on identical patients and folds. \textbf {f},~The seven-encoder pool against TITAN alone, paired on patients}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {All 275 pathways.} \textbf  {a},~Univariate Cox score statistic against $-\log _{10} p$, signed by whether the pathway scores above or below chance as a raw risk score. The dashed line is the smallest $p$ that would clear Benjamini--Hochberg at $q<0.10$, and no pathway reaches it. \textbf  {b},~Each pathway's Spearman correlation with the slide arm against its correlation with the transcriptome arm. \textbf  {c},~Absolute Spearman correlation of each pathway with each arm, pathways ranked by it. \textbf  {d},~The distribution of those absolute correlations.}}{16}{figure.2}\protected@file@percent }
\newlabel{fig:landscape}{{2}{16}{\textbf {All 275 pathways.} \textbf {a},~Univariate Cox score statistic against $-\log _{10} p$, signed by whether the pathway scores above or below chance as a raw risk score. The dashed line is the smallest $p$ that would clear Benjamini--Hochberg at $q<0.10$, and no pathway reaches it. \textbf {b},~Each pathway's Spearman correlation with the slide arm against its correlation with the transcriptome arm. \textbf {c},~Absolute Spearman correlation of each pathway with each arm, pathways ranked by it. \textbf {d},~The distribution of those absolute correlations}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {What the two molecular-facing arms read.} Descriptive throughout. \textbf  {a},~Four of the eight axes are prognostic after Benjamini--Hochberg correction. \textbf  {b},~The transcriptome arm reads molecular class and the slide arm does not. \textbf  {c},~Concordance inside each half of the basal-minus-luminal axis. \textbf  {d},~The ten strongest of the slide arm's 275 pathway associations. \textbf  {e},~The twelve patients of the second pre-specified case series.}}{17}{figure.3}\protected@file@percent }
\newlabel{fig:biology}{{3}{17}{\textbf {What the two molecular-facing arms read.} Descriptive throughout. \textbf {a},~Four of the eight axes are prognostic after Benjamini--Hochberg correction. \textbf {b},~The transcriptome arm reads molecular class and the slide arm does not. \textbf {c},~Concordance inside each half of the basal-minus-luminal axis. \textbf {d},~The ten strongest of the slide arm's 275 pathway associations. \textbf {e},~The twelve patients of the second pre-specified case series}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {All three modalities across the cohort, on one patient axis.} All 359 patients, ordered by ModRank risk, with every row drawn against that ordering. \textbf  {a},~Twenty-four diagnostic slides sampled at even risk quantiles, at matched physical resolution. \textbf  {b},~The forty pathways with the strongest univariate association, standardised across the cohort, one column per patient. The arm itself reads all 275. \textbf  {c},~Pathologic stage. Higher stages are enriched to the right, but the row is not sorted, and the rank correlation between the ordering and stage is printed in the panel. \textbf  {d},~The three arm percentiles against the same ordering, with the ModRank curve through them and a rug of the 113 deaths.}}{18}{figure.4}\protected@file@percent }
\newlabel{fig:cohort}{{4}{18}{\textbf {All three modalities across the cohort, on one patient axis.} All 359 patients, ordered by ModRank risk, with every row drawn against that ordering. \textbf {a},~Twenty-four diagnostic slides sampled at even risk quantiles, at matched physical resolution. \textbf {b},~The forty pathways with the strongest univariate association, standardised across the cohort, one column per patient. The arm itself reads all 275. \textbf {c},~Pathologic stage. Higher stages are enriched to the right, but the row is not sorted, and the rank correlation between the ordering and stage is printed in the panel. \textbf {d},~The three arm percentiles against the same ordering, with the ModRank curve through them and a rug of the 113 deaths}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {The ten patients of the first pre-specified case series, with their histology.} Within the middle tertile of the clinical model's risk, the five patients ModRank scores highest (above) and the five it scores lowest (below), with one diagnostic slide per patient at matched physical resolution. Under each slide the three modality percentiles are drawn as a stack. The series is reported whole, including patients whose outcome runs against their score. TCGA-XF-AAN1 is among the five lowest and died at 31.4 months, and TCGA-2F-A9KT is among the five highest and was alive at 110.5 months. Ten patients cannot resolve an association, and the selection rule was fixed before any output was inspected.}}{19}{figure.5}\protected@file@percent }
\newlabel{fig:cases}{{5}{19}{\textbf {The ten patients of the first pre-specified case series, with their histology.} Within the middle tertile of the clinical model's risk, the five patients ModRank scores highest (above) and the five it scores lowest (below), with one diagnostic slide per patient at matched physical resolution. Under each slide the three modality percentiles are drawn as a stack. The series is reported whole, including patients whose outcome runs against their score. TCGA-XF-AAN1 is among the five lowest and died at 31.4 months, and TCGA-2F-A9KT is among the five highest and was alive at 110.5 months. Ten patients cannot resolve an association, and the selection rule was fixed before any output was inspected}{figure.5}{}}
